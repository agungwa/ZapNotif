{
  "name": "zapnotif",
  "version": "1.0.0",
  "description": "ZapNotif — unofficial WhatsApp notification & OTP API (Baileys + Bun)",
  "license": "MIT",
  "keywords": [
    "whatsapp",
    "notification",
    "otp",
    "baileys",
    "bun",
    "hono",
    "zapnotif"
  ],
  "type": "module",
  "workspaces": [
    "dashboard"
  ],
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:dashboard": "bun run --cwd dashboard dev",
    "build:dashboard": "bun run --cwd dashboard build",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:dashboard": "bun run --cwd dashboard typecheck"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@whiskeysockets/baileys": "^6.7.16",
    "hono": "^4.6.14",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.7.2"
  },
  "trustedDependencies": [
    "protobufjs"
  ]
}
